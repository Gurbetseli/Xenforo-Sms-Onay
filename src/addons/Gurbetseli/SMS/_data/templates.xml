  <template type="public" title="gurbetseli_sms_checkcode" version_id="2000031" version_string="2.0.0 Beta 1"><![CDATA[<xf:title>{{ phrase('gurbetseli_sms_index_title') }}
</xf:title>

<xf:wrap template="account_wrapper"/>

<xf:form action="{{ link('account/sms/verifycode') }}" class="block" ajax="true">
    <div class="block-container">
        <div class="block-body">
            <xf:macro name="gurbetseli_sms_index_form_fields" arg-context="account"/>
            <xf:submitrow label="Uygula" icon="apply"/>
        </div>
    </div>
</xf:form>


<xf:macro name="gurbetseli_sms_index_form_fields" arg-context="!">
    <xf:textboxrow name="gurbetseli_sms[code]"
				   type="number"
				   step="1"
				   min="10000000"
				   max="99999999"
                   label="{{ phrase('gurbetseli_sms_check_code') }}"
                   explain="{{ phrase('gurbetseli_sms_check_code_explain', {'link': link('account/sms/sendcode'), 'interval': $xf.options.gurbetseli_sms_smsinterval}) }}"/>
</xf:macro>]]></template>
  <template type="admin" title="gurbetseli_sms_option_macros" version_id="2000035" version_string="2.0.0 Beta 5"><![CDATA[<xf:macro name="option_form_block" arg-group="" arg-options="!" arg-containerBeforeHtml="">
    <xf:if is="$options is not empty">
        <xf:form action="{{ link('options/update') }}" ajax="true" class="block">
            {$containerBeforeHtml|raw}
            <div class="block-container">
                <h2 class="block-tabHeader tabs" data-xf-init="tabs" role="tablist">
                    <a class="tabs-tab is-active" role="tab" tabindex="0" aria-controls="generalOptions">Genel ayarlar</a>
                    <a class="tabs-tab" role="tab" tabindex="0" aria-controls="permissionOptions">{{ phrase('gurbetseli_sms_permission_options') }}</a>
                    <a class="tabs-tab" role="tab" tabindex="0" aria-controls="apiChooserOptions">{{ phrase('gurbetseli_sms_api_chooser_options') }}</a>
                </h2>
                <ul class="tabPanes">
                    <li class="is-active" role="tabpanel" id="generalOptions">
                        <div class="block-body">
                            <xf:foreach loop="$options" value="$option">
                            <xf:if is="$option.Relations.gurbetseli_sms.display_order < 200">
                                <xf:macro template="option_macros" name="option_row" arg-group="{$group}" arg-option="{$option}" />
                            </xf:if>
                            </xf:foreach>
                        </div>
                    </li>
                    <li role="tabpanel" id="permissionOptions">
                        <div class="block-body">
                            <xf:foreach loop="$options" value="$option">
                            <xf:if is="$option.Relations.gurbetseli_sms.display_order >= 200 AND $option.Relations.gurbetseli_sms.display_order < 1000">
                                <xf:macro template="option_macros" name="option_row" arg-group="{$group}" arg-option="{$option}" />
                            </xf:if>
                            </xf:foreach>
                        </div>
                    </li>
                    <li role="tabpanel" id="apiChooserOptions">
                        <div class="block-body">
                            <xf:foreach loop="$options" value="$option">
                            <xf:if is="$option.Relations.gurbetseli_sms.display_order == 1000">
                                <xf:macro template="option_macros" name="option_row" arg-group="{$group}" arg-option="{$option}" />
                            </xf:if>
                            </xf:foreach>
                        </div>
                    </li>
                </ul>
                <xf:submitrow sticky="true" icon="save" label="Kaydet" />
            </div>
        </xf:form>
    </xf:if>
</xf:macro>]]></template>
  <template type="public" title="gurbetseli_sms_sendcode" version_id="2000032" version_string="2.0.0 Beta 2"><![CDATA[<xf:title>{{ phrase('gurbetseli_sms_index_title') }}
</xf:title>

<xf:wrap template="account_wrapper"/>

<xf:form action="{{ link('account/sms/requestcode') }}" class="block" ajax="true">
    <div class="block-container">
        <div class="block-body">
            <xf:macro name="gurbetseli_sms_index_form_fields" arg-context="account"/>
            <xf:submitrow label="Uygula" icon="apply"/>
        </div>
    </div>
</xf:form>

<xf:macro name="gurbetseli_sms_index_form_fields" arg-context="!">
    <xf:textboxrow name="gurbetseli_sms[phone_number]"
          type="number"
          step="1"
		  id="152"
          min="5000000000"
          max="5999999999"
          label="{{ phrase('gurbetseli_sms_index_phone_number') }}"
          explain="{{ phrase('gurbetseli_sms_index_phone_number_explain', {'link': link('account/sms/checkcode')}) }}"/>
</xf:macro>]]></template>
